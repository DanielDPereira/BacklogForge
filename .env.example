# BacklogForge - Configuração de Variáveis de Ambiente

# Configurações do Provedor de IA (Google Gemini API)
# -----------------------------------------------------------------------------
# Opção 1: Chave Única da API do Gemini
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Opção 2: Múltiplas Chaves para Rotação e Fallback Automático (Recomendado)
# Quando uma chave atingir o limite de quota (HTTP 429), o BacklogForge
# rotacionará automaticamente para a próxima chave disponível.
# Separe as chaves por vírgula no campo GEMINI_API_KEYS ou no próprio GEMINI_API_KEY:
# GEMINI_API_KEYS=sua_chave_1_aqui,sua_chave_2_aqui,sua_chave_3_aqui

# Configuração do Modelo do Gemini (Opcional - Padrão: gemini-2.5-flash)
# Modelos candidatos com suporte a fallback automático: gemini-2.5-flash, gemini-2.5-pro, gemini-3.6-flash, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Configurações do Servidor Backend
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
